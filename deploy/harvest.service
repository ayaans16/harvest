[Unit]
Description=harvest voxel tree
After=network-online.target
Wants=network-online.target

[Service]
User=harvest
ExecStart=/opt/harvest/harvest serve
EnvironmentFile=/etc/harvest.env
StateDirectory=harvest
# lets an unprivileged user bind :80 and :443 so no reverse proxy is needed
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target
